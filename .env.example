# Copy to .env and fill in what you have. Every value is optional — a
# missing key just leaves that provider disabled (server still starts fine).

# Protects /admin/* endpoints. If unset, XRouter generates a random token at
# startup and prints it to the log once — set this to make it stable.
XROUTER_ADMIN_TOKEN=

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# XROUTER_CONFIG_DIR=./config
# XROUTER_DATA_DIR=./data
